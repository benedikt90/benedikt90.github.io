{% extends "base.html.j2" %}
{% block metadata %}
  <title>Research – {{ site_title | e }}</title>
  <meta name="description" content="Security research and writing by {{ site_title | e }}." />
  <link rel="canonical" href="{{ canonical | e }}" />
  <meta property="og:title" content="Research – {{ site_title | e }}" />
  <meta property="og:description" content="Security research and writing by {{ site_title | e }}." />
  <meta property="og:url" content="{{ canonical | e }}" />
{% endblock %}
{% block research_current %} aria-current="page"{% endblock %}
{% block content %}
  <main class="listing shell" id="main">
    <header class="page-heading">
      <div>
        <span class="section-path" aria-hidden="true">research/</span>
        <h1>Research</h1>
        <p>Security research &amp; writing</p>
      </div>
    </header>
    <ul class="post-list">
      {% for post in posts %}
      <li class="post-item">
        <a class="post-link" href="/research/{{ post.slug | e }}/">
          <span class="item-date meta">{{ post.date_str | e }}</span>
          <div>
            <h2 class="item-title">{{ post.title | e }}</h2>
            <p class="item-desc">{{ post.description | e }}</p>
            {% if post.tags %}
            <ul class="item-tags" aria-label="Topics">
              {% for tag in post.tags %}<li>{{ tag | e }}</li>{% endfor %}
            </ul>
            {% endif %}
          </div>
          <span class="item-arrow" aria-hidden="true">→</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </main>
{% endblock %}
