<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} – {{ site_title }}</title>
  <meta name="description" content="{{ description }}" />
  <link rel="canonical" href="{{ canonical }}" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:url" content="{{ canonical }}" />
  <meta property="og:image" content="{{ og_image_url }}" />
  <meta property="og:site_name" content="{{ site_title }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="{{ og_image_url }}" />
  <!-- Apply theme before render to prevent flash -->
  <script>
    (function() {
      var t = localStorage.getItem('bentr-theme') ||
              (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = t;
    })();
  </script>
  <style>
  {% raw %}
    /* ── Theme variables ── */
    :root {
      --bg:              #080c08;
      --surface:         rgba(8, 12, 20, 0.62);
      --surface-dark:    rgba(4, 6, 14, 0.92);
      --border:          rgba(100, 140, 255, 0.13);
      --border-muted:    rgba(100, 140, 255, 0.08);
      --border-mid:      rgba(100, 140, 255, 0.10);
      --border-strong:   rgba(100, 140, 255, 0.25);
      --text:            #b8cce4;
      --text-heading:    #e8f0ff;
      --text-muted:      #7a9acc;
      --text-faint:      #4a6a9a;
      --text-very-faint: #2a4a7a;
      --text-strong:     #d0e4ff;
      --text-em:         #9ab8d8;
      --link:            #6a9adf;
      --link-hover:      #a8c8ff;
      --code-fg:         #7dd3c0;
      --code-bg:         rgba(80, 200, 180, 0.08);
      --code-border:     rgba(100, 200, 180, 0.12);
      --pre-bg:          rgba(4, 8, 16, 0.70);
      --caption:         #4a6a8a;
      --toc-fg:          #4a6a8a;
      --toc-active:      #8ab8e0;
      --glow:            rgba(100, 140, 255, 0.4);
      --glow-sm:         rgba(100, 140, 255, 0.35);
      --img-shadow:      0 2px 14px rgba(0, 0, 0, 0.35), 0 0 18px rgba(80, 140, 255, 0.12);
      --accent-bg:       rgba(80, 120, 255, 0.05);
      --accent-hover:    rgba(80, 120, 255, 0.10);
    }

    [data-theme="light"] {
      --bg:              #eef2f8;
      --surface:         rgba(255, 255, 255, 0.88);
      --surface-dark:    rgba(245, 248, 255, 0.97);
      --border:          rgba(60, 100, 200, 0.15);
      --border-muted:    rgba(60, 100, 200, 0.08);
      --border-mid:      rgba(60, 100, 200, 0.12);
      --border-strong:   rgba(60, 100, 200, 0.28);
      --text:            #1a2840;
      --text-heading:    #0c1824;
      --text-muted:      #3a5878;
      --text-faint:      #5a7898;
      --text-very-faint: #8aaab8;
      --text-strong:     #0c1824;
      --text-em:         #2a4a6a;
      --link:            #1a4a90;
      --link-hover:      #0a2a60;
      --code-fg:         #1a6050;
      --code-bg:         rgba(0, 100, 80, 0.06);
      --code-border:     rgba(0, 130, 110, 0.15);
      --pre-bg:          rgba(225, 235, 250, 0.95);
      --caption:         #5a7898;
      --toc-fg:          #3a5878;
      --toc-active:      #1a4a90;
      --glow:            rgba(60, 100, 200, 0.22);
      --glow-sm:         rgba(60, 100, 200, 0.15);
      --img-shadow:      0 2px 12px rgba(0, 0, 0, 0.12), 0 1px 4px rgba(0, 0, 0, 0.08);
      --accent-bg:       rgba(60, 100, 200, 0.05);
      --accent-hover:    rgba(60, 100, 200, 0.12);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    html, body {
      height: 100%;
      background: var(--bg);
      font-family: 'Courier New', Courier, monospace;
      overflow-x: hidden;
      transition: background 0.25s;
    }

    #bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      opacity: 0.14;
    }

    /* ── Theme toggle ── */
    .theme-toggle {
      margin-left: auto;
      background: none;
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--text-muted);
      cursor: pointer;
      padding: 0.3rem 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s, border-color 0.2s;
      flex-shrink: 0;
    }
    .theme-toggle:hover { color: var(--text-heading); border-color: var(--border-strong); }
    .theme-toggle svg { width: 14px; height: 14px; }

    .icon-moon { display: none; }
    .icon-sun  { display: block; }
    [data-theme="light"] .icon-moon { display: block; }
    [data-theme="light"] .icon-sun  { display: none; }

    /* ── Top bar (hides on scroll-down, reappears on scroll-up) ── */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 2;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--border-muted);
      background: var(--surface-dark);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transform: translateY(0);
      transition: transform 0.28s ease, opacity 0.28s ease;
    }
    .topbar.hide {
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
    }

    .topbar > a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      transition: color 0.2s;
    }
    .topbar > a:hover { color: var(--text-heading); }
    .topbar > a::before { content: '← '; }

    /* ── Layout ── */
    main {
      position: relative;
      z-index: 1;
      max-width: 780px;
      margin: 0 auto;
      padding: 2rem 2rem 4rem;
    }

    /* ── Glass reading panel ── */
    .content {
      background: var(--surface);
      backdrop-filter: blur(10px) saturate(1.1);
      -webkit-backdrop-filter: blur(10px) saturate(1.1);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2.5rem 3rem;
      transition: background 0.25s, border-color 0.25s;
    }

    /* ── Post header ── */
    .post-meta {
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-mid);
    }

    .post-date {
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-faint);
      margin-bottom: 0.9rem;
    }

    .post-title {
      font-size: clamp(1.4rem, 4vw, 2rem);
      line-height: 1.3;
      letter-spacing: 0.04em;
      color: var(--text-heading);
      text-shadow: 0 0 24px var(--glow);
      margin-bottom: 1rem;
    }

    .post-description {
      font-size: 0.95rem;
      line-height: 1.65;
      color: var(--text-muted);
      font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 1rem;
    }

    .post-tag {
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      border: 1px solid var(--border-strong);
      border-radius: 2px;
      padding: 0.2rem 0.55rem;
      color: var(--text-faint);
      background: var(--accent-bg);
    }

    /* ── Article body ── */
    article {
      font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 1.02rem;
      line-height: 1.82;
      color: var(--text);
    }

    article h1, article h2, article h3, article h4 {
      font-family: 'Courier New', Courier, monospace;
      color: var(--text-heading);
      text-shadow: 0 0 16px var(--glow-sm);
      letter-spacing: 0.05em;
      margin-top: 2.4rem;
      margin-bottom: 0.75rem;
      line-height: 1.3;
      scroll-margin-top: 1.5rem;
    }

    article h1 { font-size: 1.65rem; display: none; }
    article h2 { font-size: 1.25rem; border-bottom: 1px solid var(--border-mid); padding-bottom: 0.4rem; }
    article h3 { font-size: 1.05rem; color: var(--text-muted); text-shadow: none; }
    article h4 { font-size: 0.95rem; color: var(--text-faint); text-shadow: none; letter-spacing: 0.08em; text-transform: uppercase; }

    article p { margin-bottom: 1.2rem; }

    article a {
      color: var(--link);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 0.2s;
    }
    article a:hover { color: var(--link-hover); }

    article strong { color: var(--text-strong); font-weight: 600; }
    article em { color: var(--text-em); font-style: italic; }

    article ul, article ol { margin: 0.4rem 0 1.2rem 1.6rem; }
    article li { margin-bottom: 0.4rem; }
    article li p { margin-bottom: 0; }

    article blockquote {
      border-left: 3px solid var(--border-strong);
      margin: 1.5rem 0;
      padding: 0.75rem 1.25rem;
      background: var(--accent-bg);
      border-radius: 0 4px 4px 0;
      color: var(--text-muted);
      font-style: italic;
    }

    article hr {
      border: none;
      border-top: 1px solid var(--border-mid);
      margin: 2.5rem 0;
    }

    /* ── Code ── */
    article code {
      font-family: 'Courier New', Courier, monospace;
      font-size: 0.88em;
      color: var(--code-fg);
      background: var(--code-bg);
      padding: 0.15em 0.4em;
      border-radius: 3px;
      border: 1px solid var(--code-border);
    }

    article pre {
      background: var(--pre-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.2rem 1.4rem;
      overflow-x: auto;
      margin: 1.4rem 0;
    }

    article pre code {
      background: none;
      border: none;
      padding: 0;
      font-size: 0.875rem;
      color: #a8c8a0;
      line-height: 1.6;
    }

    /* Pygments codehilite — dark */
    .codehilite { background: rgba(4,8,16,0.7) !important; border: 1px solid var(--border); border-radius: 6px; padding: 1.2rem 1.4rem; overflow-x: auto; margin: 1.4rem 0; }
    .codehilite pre { background: none; border: none; padding: 0; margin: 0; }
    .codehilite .hll { background-color: rgba(100,140,255,0.1); }
    .codehilite .c, .codehilite .cm, .codehilite .c1, .codehilite .cs { color: #556670; font-style: italic; }
    .codehilite .k  { color: #7ab4f5; font-weight: bold; }
    .codehilite .s, .codehilite .s1, .codehilite .s2 { color: #7ec8a0; }
    .codehilite .n  { color: #c8d8f0; }
    .codehilite .na { color: #a8d8b0; }
    .codehilite .nb { color: #7ab4f5; }
    .codehilite .nc { color: #e0c878; }
    .codehilite .nf { color: #a8c8ff; }
    .codehilite .o  { color: #7a9acc; }
    .codehilite .mi, .codehilite .mf { color: #f0a878; }
    .codehilite .cp { color: #7a9acc; }

    /* Pygments codehilite — light overrides */
    [data-theme="light"] .codehilite { background: var(--pre-bg) !important; }
    [data-theme="light"] .codehilite .c,
    [data-theme="light"] .codehilite .cm,
    [data-theme="light"] .codehilite .c1,
    [data-theme="light"] .codehilite .cs { color: #5a7898; }
    [data-theme="light"] .codehilite .k  { color: #1a3a80; }
    [data-theme="light"] .codehilite .s,
    [data-theme="light"] .codehilite .s1,
    [data-theme="light"] .codehilite .s2 { color: #1a6050; }
    [data-theme="light"] .codehilite .n  { color: #1a2840; }
    [data-theme="light"] .codehilite .na { color: #1a5040; }
    [data-theme="light"] .codehilite .nb { color: #1a3a80; }
    [data-theme="light"] .codehilite .nc { color: #7a6010; }
    [data-theme="light"] .codehilite .nf { color: #1a3a80; }
    [data-theme="light"] .codehilite .o  { color: #3a5880; }
    [data-theme="light"] .codehilite .mi,
    [data-theme="light"] .codehilite .mf { color: #7a3010; }
    [data-theme="light"] .codehilite .cp { color: #3a5880; }
    [data-theme="light"] article pre code { color: #1a2840; }

    /* ── Figures + captions ── */
    article figure {
      margin: 2rem 0;
      text-align: center;
    }

    article figure img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 0 auto;
      border-radius: 6px;
      border: 1px solid var(--border);
      box-shadow: var(--img-shadow);
      cursor: zoom-in;
    }

    article figcaption {
      font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 0.8rem;
      line-height: 1.55;
      color: var(--caption);
      margin-top: 0.65rem;
      padding: 0 1rem;
      font-style: italic;
    }

    article img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 2rem auto;
      border-radius: 6px;
      border: 1px solid var(--border);
      box-shadow: var(--img-shadow);
    }

    /* ── Tables ── */
    article table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.9rem;
    }
    article th {
      font-family: 'Courier New', Courier, monospace;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-strong);
      padding: 0.6rem 0.8rem;
      text-align: left;
    }
    article td {
      padding: 0.6rem 0.8rem;
      border-bottom: 1px solid var(--border-muted);
      color: var(--text);
    }
    article tr:hover td { background: var(--accent-bg); }

    /* ── TOC sidebar (desktop ≥ 1200px) ── */
    .toc-sidebar { display: none; }

    @media (min-width: 1200px) {
      .toc-sidebar {
        display: block;
        position: fixed;
        top: 5rem;
        left: clamp(1rem, calc(50% - 620px), calc(50% - 420px));
        width: clamp(140px, calc(50% - 430px), 200px);
        z-index: 2;
      }

      .toc-sidebar nav {
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
      }

      .toc-sidebar .toc-label {
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-very-faint);
        margin-bottom: 0.75rem;
      }

      .toc-sidebar a {
        display: block;
        color: var(--toc-fg);
        text-decoration: none;
        padding: 0.3rem 0 0.3rem 0.7rem;
        border-left: 2px solid transparent;
        line-height: 1.4;
        transition: color 0.15s, border-color 0.15s;
      }

      .toc-sidebar a:hover { color: var(--text-heading); border-color: var(--border-strong); }
      .toc-sidebar a.active { color: var(--toc-active); border-color: var(--toc-active); }
    }

    /* Always hidden; shown only via .open on mobile */
    #toc-dropdown { display: none; }

    /* ── TOC mobile bar ── */
    .toc-bar { display: none; }

    @media (max-width: 1199px) {
      .toc-bar {
        display: flex;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 10;
        background: var(--surface-dark);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-top: 1px solid var(--border-mid);
        padding: 0.55rem 1rem;
        gap: 0.5rem;
        align-items: center;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
      }

      .toc-bar button {
        background: none;
        border: 1px solid var(--border);
        border-radius: 3px;
        color: var(--text-muted);
        font-family: inherit;
        font-size: inherit;
        letter-spacing: inherit;
        padding: 0.3rem 0.7rem;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        flex-shrink: 0;
      }

      .toc-bar button:hover { background: var(--accent-hover); color: var(--text-heading); }
      .toc-bar .toc-top { margin-left: auto; }

      .toc-dropdown {
        display: none;
        position: fixed;
        bottom: 2.8rem;
        left: 0;
        right: 0;
        background: var(--surface-dark);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-top: 1px solid var(--border-mid);
        padding: 0.75rem 1rem 0.5rem;
        z-index: 9;
        max-height: 60vh;
        overflow-y: auto;
      }

      .toc-dropdown.open { display: block; }

      .toc-dropdown a {
        display: block;
        color: var(--toc-fg);
        text-decoration: none;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        padding: 0.45rem 0;
        border-bottom: 1px solid var(--border-muted);
        transition: color 0.15s;
      }

      .toc-dropdown a:hover { color: var(--text-heading); }
      .toc-dropdown a:last-child { border-bottom: none; }

      footer { padding-bottom: 4rem; }
    }

    /* ── Ko-fi block ── */
    .kofi-block {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border-muted);
      text-align: center;
    }

    .kofi-block a {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      text-decoration: none;
      font-family: 'Courier New', Courier, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      color: var(--text-very-faint);
      border: 1px solid var(--border-muted);
      border-radius: 2px;
      padding: 0.45rem 0.9rem;
      background: var(--accent-bg);
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }

    .kofi-block a:hover {
      background: var(--accent-hover);
      color: var(--text-muted);
      border-color: var(--border-strong);
    }

    .kofi-block svg { width: 14px; height: 14px; fill: currentColor; flex-shrink: 0; }

    /* ── Lightbox ── */
    #lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(4, 6, 14, 0.92);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      align-items: center;
      justify-content: center;
      padding: 2rem;
      cursor: zoom-out;
    }
    #lightbox.open { display: flex; }
    #lightbox img {
      max-width: min(90vw, 1400px);
      max-height: 90vh;
      width: auto;
      height: auto;
      border-radius: 6px;
      border: 1px solid var(--border-strong);
      box-shadow: 0 8px 64px rgba(0, 0, 0, 0.8);
      cursor: default;
    }
    #lightbox-close {
      position: fixed;
      top: 1.2rem;
      right: 1.5rem;
      font-family: 'Courier New', Courier, monospace;
      font-size: 1.4rem;
      color: var(--text-faint);
      background: none;
      border: none;
      cursor: pointer;
      line-height: 1;
      transition: color 0.15s;
    }
    #lightbox-close:hover { color: var(--text-heading); }

    /* ── Footer ── */
    footer {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 2rem;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      color: var(--text-very-faint);
      border-top: 1px solid var(--border-muted);
    }

    @media (max-width: 600px) {
      main { padding: 1rem 0.8rem 3rem; }
      .content { padding: 1.5rem 1.2rem; }
      .topbar { padding: 0.8rem 1.2rem; }
    }
  {% endraw %}
  </style>
</head>
<body>

<canvas id="bg"></canvas>

{% if toc_h2s %}
<aside class="toc-sidebar">
  <nav>
    <div class="toc-label">Contents</div>
    {% for h in toc_h2s %}
    <a href="#{{ h.id }}">{{ h.name }}</a>
    {% endfor %}
  </nav>
</aside>
{% endif %}

<nav class="topbar">
  <a href="/">Benedikt</a>
  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>
</nav>

<main>
  <div class="content">
    <header class="post-meta">
      <div class="post-date">{{ date_str }}</div>
      <h1 class="post-title">{{ title }}</h1>
      <p class="post-description">{{ description }}</p>
      {% if tags %}
      <div class="post-tags">
        {% for tag in tags %}<span class="post-tag">{{ tag }}</span>{% endfor %}
      </div>
      {% endif %}
    </header>
    <article>
      {{ body_html }}
    </article>
    <div class="kofi-block">
      <a href="https://ko-fi.com/bened1kt" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z"/></svg>
        If you found this useful, consider buying me a coffee
      </a>
    </div>
  </div>
</main>

{% if toc_h2s %}
<div id="toc-dropdown" class="toc-dropdown">
  {% for h in toc_h2s %}
  <a href="#{{ h.id }}">{{ h.name }}</a>
  {% endfor %}
</div>
<div class="toc-bar">
  <button id="toc-contents-btn">Contents</button>
  <button id="toc-top-btn" class="toc-top">↑ Top</button>
</div>
{% endif %}

<div id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview">
  <button id="lightbox-close" aria-label="Close">✕</button>
  <img id="lightbox-img" src="" alt="" />
</div>

<footer>// {{ site_title }} &nbsp;·&nbsp; research</footer>

<script>
{% raw %}
(function () {
  const canvas = document.getElementById('bg');
  const ctx    = canvas.getContext('2d');
  const CHARS  = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&?!<>[]{}αβγδεζθλμξπσφψω';
  let W, H, cx, cy, R, t = 0;
  const N_SPHERE = 2200, spherePts = [];

  (function buildFibSphere() {
    const golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < N_SPHERE; i++) {
      const y = 1 - (i / (N_SPHERE - 1)) * 2;
      const r = Math.sqrt(1 - y * y), phi = golden * i;
      spherePts.push({ x: Math.cos(phi) * r, y, z: Math.sin(phi) * r, ch: CHARS[i % CHARS.length] });
    }
  })();

  function rotateYX(x, y, z, ry, rx) {
    const x1 = x * Math.cos(ry) + z * Math.sin(ry), z1 = -x * Math.sin(ry) + z * Math.cos(ry);
    return [x1, y * Math.cos(rx) - z1 * Math.sin(rx), y * Math.sin(rx) + z1 * Math.cos(rx)];
  }

  function project(x, y, z) {
    const camZ = 2.2, dz = camZ + z, scale = R / camZ;
    return [cx + (x / dz) * scale * camZ, cy + (y / dz) * scale * camZ, dz];
  }

  function init() {
    canvas.width = W = window.innerWidth;
    canvas.height = H = window.innerHeight;
    cx = W / 2; cy = H / 2; R = Math.min(W, H) * 1.25;
  }

  function draw() {
    t += 0.012;
    const isLight = document.documentElement.dataset.theme === 'light';
    ctx.fillStyle = isLight ? 'rgba(238,242,248,0.4)' : 'rgba(8,12,8,0.35)';
    ctx.fillRect(0, 0, W, H);

    const ry = t * 0.18, rx = Math.sin(t * 0.11) * 0.4;
    const breathe = 1 + 0.04 * Math.sin(t * 0.9);
    const visible = [];

    for (const p of spherePts) {
      const theta = Math.atan2(p.z, p.x), phi = Math.asin(Math.max(-1, Math.min(1, p.y)));
      const disp = 1 + 0.028 * Math.sin(4 * theta + t * 1.3) + 0.018 * Math.sin(6 * phi + t * 0.9)
                     + 0.012 * Math.sin(9 * theta - t * 1.8) + 0.008 * Math.sin(3 * phi + t * 2.1);
      const r = breathe * disp;
      const [rx2, ry2, rz2] = rotateYX(p.x * r, p.y * r, p.z * r, ry, rx);
      const [sx, sy, sdz]   = project(rx2, ry2, rz2);
      const lx = -0.5, ly = -0.7, lz = 0.5, nl = Math.sqrt(lx*lx + ly*ly + lz*lz);
      const lit = Math.max(0, (rx2*lx + ry2*ly + rz2*lz) / (r * nl));
      visible.push({ sx, sy, sdz, lit, facing: rz2 / r, ch: p.ch, hs: (p.y + 1) * 0.5 });
    }

    visible.sort((a, b) => a.sdz - b.sdz);
    ctx.font = '11px monospace';
    for (const v of visible) {
      const brightness = 0.15 + v.lit * 0.85;
      const alpha = v.facing > -0.1 ? brightness * 0.9 : brightness * 0.15;
      const hue = 120 + v.hs * 80;
      const sat = isLight ? 70 + Math.floor(v.lit * 20) : 80 + Math.floor(v.lit * 20);
      const lgt = isLight ? 45 - Math.floor(v.lit * 30) : 20 + Math.floor(v.lit * 45);
      ctx.globalAlpha = alpha;
      ctx.fillStyle = `hsl(${hue},${sat}%,${lgt}%)`;
      ctx.fillText(v.ch, v.sx, v.sy);
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(draw);
  }

  init();
  window.addEventListener('resize', init);
  requestAnimationFrame(draw);
})();

// ── Theme toggle ─────────────────────────────────────────────────────────────
(function () {
  const btn = document.getElementById('theme-toggle');
  if (!btn) return;
  btn.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('bentr-theme', next);
  });
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', e => {
    if (!localStorage.getItem('bentr-theme'))
      document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
  });
})();

// ── Topbar hide on scroll-down, show on scroll-up ────────────────────────────
(function () {
  const bar = document.querySelector('.topbar');
  if (!bar) return;
  let last = window.scrollY, ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        const cur = window.scrollY;
        if (cur > last && cur > 80) bar.classList.add('hide');
        else bar.classList.remove('hide');
        last = cur;
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
})();

// ── TOC scroll-spy + mobile toggle ───────────────────────────────────────────
(function () {
  const sidebarLinks = document.querySelectorAll('.toc-sidebar a');
  if (sidebarLinks.length) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          sidebarLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + id));
        }
      });
    }, { rootMargin: '-10% 0px -80% 0px', threshold: 0 });
    document.querySelectorAll('article h2').forEach(h => observer.observe(h));
  }

  const contentsBtn = document.getElementById('toc-contents-btn');
  const dropdown    = document.getElementById('toc-dropdown');
  if (contentsBtn && dropdown) {
    contentsBtn.addEventListener('click', () => dropdown.classList.toggle('open'));
    dropdown.querySelectorAll('a').forEach(a => a.addEventListener('click', () => dropdown.classList.remove('open')));
    document.addEventListener('click', e => {
      if (!dropdown.contains(e.target) && e.target !== contentsBtn) dropdown.classList.remove('open');
    });
  }

  const topBtn = document.getElementById('toc-top-btn');
  if (topBtn) topBtn.addEventListener('click', () => {
    document.documentElement.scrollTo({ top: 0, behavior: 'smooth' });
    document.body.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();

// ── Lightbox ──────────────────────────────────────────────────────────────────
(function () {
  const box = document.getElementById('lightbox');
  const boxImg = document.getElementById('lightbox-img');
  const closeBtn = document.getElementById('lightbox-close');
  if (!box) return;

  function open(src, alt) { boxImg.src = src; boxImg.alt = alt; box.classList.add('open'); document.body.style.overflow = 'hidden'; }
  function close() { box.classList.remove('open'); document.body.style.overflow = ''; boxImg.src = ''; }

  document.querySelectorAll('article figure img').forEach(img => img.addEventListener('click', () => open(img.src, img.alt)));
  closeBtn.addEventListener('click', close);
  box.addEventListener('click', e => { if (e.target === box) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
})();
{% endraw %}
</script>
